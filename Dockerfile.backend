FROM kalilinux/kali-rolling

# Avoid interactive prompts during apt installation
ENV DEBIAN_FRONTEND=noninteractive

# Update and install system dependencies (Security Tools)
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    nmap \
    whatweb \
    nuclei \
    nikto \
    wpscan \
    sqlmap \
    enum4linux \
    wfuzz \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install JoomScan manually
RUN git clone https://github.com/OWASP/joomscan.git /opt/joomscan && \
    ln -s /opt/joomscan/joomscan.pl /usr/local/bin/joomscan

# Set up Python Environment
WORKDIR /app

# Create and activate virtual environment
# This prevents conflicts with Kali's system Python packages
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy Codebase
COPY . .

# Expose Port
EXPOSE 8000

# Run Server
CMD ["python", "orchestrator/server.py"]
