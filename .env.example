# Required: OpenRouter API Key
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter model to use (default: openai/gpt-4o-mini)
# Browse models at: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Required for protected backend API routes. Generate with: openssl rand -hex 32
ASTRA_API_TOKEN=replace_with_a_long_random_token
APP_PASSWORD=replace_with_a_strong_app_password

# Browser origin allowed to call the backend (not required for server-side Streamlit requests)
FRONTEND_ORIGIN=http://localhost:8501

# Optional: NVD API Key for enhanced CVE data
# Get your key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here

# Optional: Neo4j Graph Database (for persistent graph storage)
# If not set, ASTRA uses in-memory NetworkX graphs
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
