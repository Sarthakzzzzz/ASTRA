# ── Gemini / Google AI ─────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── NVD (National Vulnerability Database) ─────────────────────
# Optional — increases rate limits for CVE lookups
# Get a free key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here

# ── Tavily Search (used by RAG research agent) ─────────────────
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── LangSmith Tracing (optional — for LangGraph observability) ─
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ASTRA_RAG_Tracing
# Get a key at https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here

# ── Neo4j Graph Database (optional — for attack graph storage) ─
# Create a free AuraDB instance at https://neo4j.com/cloud/aura/
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=your_neo4j_database
AURA_INSTANCEID=your_instance_id
AURA_INSTANCENAME=your_instance_name
